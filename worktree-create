#!/usr/bin/env bash

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Default values
BASE_BRANCH="main"
WORKTREE_ROOT=".worktrees"
COPY_ENV=false

usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS] <branch-name>

Create a git worktree with .env files synced from the main repo.

Arguments:
    <branch-name>       Name for the new worktree/branch

Options:
    -b, --base <branch>     Base branch to create from (default: main)
    -d, --dir <path>        Worktree root directory (default: .worktrees)
    -c, --copy-env          Copy .env files instead of symlinking
    -h, --help              Show this help message

Examples:
    # Create worktree 'feature-auth' from main
    $(basename "$0") feature-auth

    # Create from a different base branch
    $(basename "$0") -b develop my-experiment

    # Use custom worktree location
    $(basename "$0") -d ../worktrees feature-ui

    # Copy .env files instead of symlinking
    $(basename "$0") --copy-env hotfix-123

EOF
    exit 0
}

error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

info() {
    echo -e "${GREEN}✓${NC} $1"
}

warn() {
    echo -e "${YELLOW}⚠${NC} $1"
}

# Parse arguments
BRANCH_NAME=""
while [[ $# -gt 0 ]]; do
    case $1 in
        -b|--base)
            BASE_BRANCH="$2"
            shift 2
            ;;
        -d|--dir)
            WORKTREE_ROOT="$2"
            shift 2
            ;;
        -c|--copy-env)
            COPY_ENV=true
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            error "Unknown option: $1. Use -h for help."
            ;;
        *)
            BRANCH_NAME="$1"
            shift
            ;;
    esac
done

# Validate branch name provided
if [[ -z "$BRANCH_NAME" ]]; then
    error "Branch name is required. Use -h for help."
fi

# Check if we're in a git repo
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    error "Not a git repository"
fi

# Get repo root
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Resolve worktree root (handle relative paths)
if [[ "$WORKTREE_ROOT" = /* ]]; then
    # Absolute path
    WORKTREE_DIR="$WORKTREE_ROOT/$BRANCH_NAME"
else
    # Relative to repo root
    WORKTREE_DIR="$REPO_ROOT/$WORKTREE_ROOT/$BRANCH_NAME"
fi

# Check if base branch exists
if ! git rev-parse --verify "$BASE_BRANCH" > /dev/null 2>&1; then
    error "Base branch '$BASE_BRANCH' does not exist"
fi

# Check if worktree directory already exists
if [[ -d "$WORKTREE_DIR" ]]; then
    error "Worktree directory already exists: $WORKTREE_DIR"
fi

# Check if branch already exists
if git rev-parse --verify "$BRANCH_NAME" > /dev/null 2>&1; then
    warn "Branch '$BRANCH_NAME' already exists. Creating worktree from existing branch."
    git worktree add "$WORKTREE_DIR" "$BRANCH_NAME"
else
    info "Creating new branch '$BRANCH_NAME' from '$BASE_BRANCH'"
    git worktree add -b "$BRANCH_NAME" "$WORKTREE_DIR" "$BASE_BRANCH"
fi

info "Worktree created at: $WORKTREE_DIR"

# Find all .env* files in the main repo
info "Looking for .env files..."
ENV_FILES=()
while IFS= read -r -d '' file; do
    # Get relative path from repo root
    REL_PATH="${file#$REPO_ROOT/}"

    # Skip files that are already in a worktree directory
    if [[ "$REL_PATH" == .worktrees/* ]] || [[ "$REL_PATH" == */.worktrees/* ]]; then
        continue
    fi

    ENV_FILES+=("$REL_PATH")
done < <(find "$REPO_ROOT" -type f -name ".env*" -print0 2>/dev/null)

if [[ ${#ENV_FILES[@]} -eq 0 ]]; then
    warn "No .env files found in repository"
else
    info "Found ${#ENV_FILES[@]} .env file(s)"

    for env_file in "${ENV_FILES[@]}"; do
        SRC="$REPO_ROOT/$env_file"
        DEST="$WORKTREE_DIR/$env_file"
        DEST_DIR=$(dirname "$DEST")

        # Create destination directory if needed
        mkdir -p "$DEST_DIR"

        if [[ "$COPY_ENV" == true ]]; then
            cp "$SRC" "$DEST"
            echo "  📄 Copied: $env_file"
        else
            ln -s "$SRC" "$DEST"
            echo "  🔗 Linked: $env_file"
        fi
    done
fi

echo ""
info "Worktree setup complete!"
echo ""
echo "To start working:"
echo "  cd $WORKTREE_DIR"
echo ""
if [[ "$COPY_ENV" == false ]] && [[ ${#ENV_FILES[@]} -gt 0 ]]; then
    echo "Note: .env files are symlinked. Changes will affect the main repo."
    echo "To convert symlinks to real files:"
    echo "  ./worktree-manage materialize $BRANCH_NAME"
fi
echo ""
echo "Manage worktrees:"
echo "  ./worktree-manage list              # List all worktrees"
echo "  ./worktree-manage remove <name>     # Remove a worktree"
